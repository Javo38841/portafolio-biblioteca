---
import LanguagePicker from './LanguagePicker.astro';
import { site, withBase } from '../data/site';
import { getLang, localizePath, useTranslations } from '../i18n/ui';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const links = [
  { href: localizePath('/#sobre-mi', lang), label: t('nav.about') },
  { href: localizePath('/#proyectos', lang), label: t('nav.projects') },
  { href: localizePath('/#enseno', lang), label: t('nav.teach') },
  { href: localizePath('/#libros', lang), label: t('nav.books') },
  { href: localizePath('/#contacto', lang), label: t('nav.contact') },
];
---

<div class="container">
  <nav aria-label={t('nav.label')}>
    <a class="brand mono" href={localizePath('/', lang)}>{site.handle}</a>
    <div class="links">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
      {site.cvPdf && <a class="cv" href={withBase(site.cvPdf)}>{t('nav.cv')}</a>}
      <LanguagePicker />
    </div>
  </nav>
</div>

<style>
  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 8px 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }
  .brand {
    font-weight: 600;
    font-size: 16px;
    color: var(--ink);
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 20px;
    font-size: 15px;
  }
  .links a {
    color: var(--ink);
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .links a:hover {
    color: var(--accent);
  }
  .links .cv {
    padding: 0 16px;
    border: 1.5px solid var(--ink);
    border-radius: 6px;
    font-weight: 600;
  }
</style>
