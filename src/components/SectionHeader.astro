---
interface Props {
  number: string;
  kicker: string;
  title: string;
  lead?: string;
}

const { number, kicker, title, lead } = Astro.props;
---

<header class="section-header">
  <div class="plaque">Capítulo {number} · {kicker}</div>
  <h2>{title}</h2>
  {lead && <p class="lead">{lead}</p>}
</header>

<style>
  .section-header {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 32px;
  }
  /* placa de bronce atornillada */
  .plaque {
    align-self: flex-start;
    position: relative;
    padding: 4px 26px;
    font-family: var(--font-sans);
    font-size: 14px;
    font-variant: small-caps;
    letter-spacing: 0.08em;
    text-transform: lowercase;
    color: #2b1d12;
    background: linear-gradient(180deg, #e2c46f, var(--brass) 55%, var(--brass-dark));
    border: 1px solid var(--brass-dark);
    border-radius: 2px;
    box-shadow: 0 2px 4px -2px rgb(0 0 0 / 0.4);
  }
  .plaque::before,
  .plaque::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 6px;
    height: 6px;
    margin-top: -3px;
    border-radius: 50%;
    background: var(--brass-dark);
  }
  .plaque::before {
    left: 9px;
  }
  .plaque::after {
    right: 9px;
  }
  h2 {
    font-size: clamp(30px, 4.4vw, 42px);
  }
  .lead {
    font-size: 17px;
    color: var(--muted);
    max-width: 760px;
  }
</style>
