---
// Página de inicio. Los textos están en src/i18n/home.ts (es / en / pt).
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from './Hero.astro';
import SectionHeader from '../SectionHeader.astro';
import Icon from '../Icon.astro';
import CopyEmail from '../CopyEmail.astro';
import BookShelf from './BookShelf.astro';
import books from '../../data/books.json';
import RecordCrate from './RecordCrate.astro';
import music from '../../data/music.json';
import { site, withBase } from '../../data/site';
import { getLang } from '../../i18n/ui';
import { home } from '../../i18n/home';

const c = home[getLang(Astro.currentLocale)];
const { now, projects } = c;
const past = now.past;
---

<BaseLayout title={c.meta.title} description={c.meta.description}>
  <Hero />

  <section id="sobre-mi" class="section container">
    <SectionHeader number="02" kicker={c.about.kicker} title={c.about.title} />
    <div class="about">
    <div class="prose">
        {c.about.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <section id="hoy" class="section container">
    <SectionHeader
      number="03"
      kicker={now.kicker}
      title={now.title}
      lead={now.lead}
    />
    <ul class="now">
      {now.items.map((n) => <li>{n}</li>)}
    </ul>
    <div class="past">
      {
        past.map((p) => (
          <article class="card past-item">
            <div class="past-head">
              <h3>{p.org}</h3>
              <span class="mono when">{p.when}</span>
            </div>
            <div class="role">{p.role}</div>
            <p>{p.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section id="proyectos" class="section container">
    <SectionHeader number="04" kicker={projects.kicker} title={projects.title} />
    <a class="featured card" href={withBase('/proyectos/lms')}>
      <div class="featured-copy">
        <div class="kicker">{projects.featuredKicker}</div>
        <h3>{projects.featuredTitle}</h3>
        <p>{projects.featuredText}</p>
        <span class="featured-cta">{projects.featuredCta} <Icon name="arrow" size={18} /></span>
      </div>
    </a>
    <div class="projects">
      {
        projects.items.map((p) => (
          <article class="card project">
            <div class="mono meta">{p.meta}</div>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
            <ul class="tags">
              {p.tags.map((t) => (
                <li class="mono">{t}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <section id="enseno" class="section container">
    <SectionHeader
      number="05"
      kicker={c.teach.kicker}
      title={c.teach.title}
      lead={c.teach.lead}
    />
    <div class="teaching">
      {
        c.teach.workshops.map((w) => (
          <article class="card teach">
            <h3>{w.title}</h3>
            <p>{w.text}</p>
            {w.items.length > 0 && (
              <ol class="classes">
                {w.items.map((i) => (
                  <li>{i}</li>
                ))}
              </ol>
            )}
          </article>
        ))
      }
    </div>
    <h3 class="subhead">{c.teach.universityTitle}</h3>
    <div class="teaching">
      {
        c.teach.university.map((u) => (
          <article class="card teach">
            <h3>{u.title}</h3>
            <p>{u.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section id="libros" class="section container">
    <SectionHeader
      number="06"
      kicker={c.books.kicker}
      title={c.books.title}
      lead={c.books.lead}
    />
    <BookShelf books={books.formation} label={c.books.label} mode="card" />
  </section>

  <section id="fuera" class="section container">
    <SectionHeader number="07" kicker={c.outside.kicker} title={c.outside.title} />
    <div class="prose">
        <p>{c.outside.text}</p>
    </div>
    <h3 class="subhead">{c.outside.musicTitle}</h3>
    <RecordCrate artists={music.artists} label={c.outside.musicLabel} />
    <h3 class="subhead">{c.outside.nightstandTitle}</h3>
    <div class="prose">
      <p>{c.outside.nightstandText}</p>
    </div>
    <div class="favorites">
      <BookShelf books={books.favorites} label={c.outside.favoritesLabel} mode="cover" />
    </div>
  </section>

  <section id="contacto" class="section container">
    <SectionHeader number="08" kicker={c.contact.kicker} title={c.contact.title} />
    <div class="contact">
      <CopyEmail variant="button" />
      <a class="btn" href={site.github}><Icon name="github" size={18} /> GitHub</a>
      {
        site.linkedin && (
          <a class="btn" href={site.linkedin}>
            <Icon name="linkedin" size={18} /> LinkedIn
          </a>
        )
      }
      {
        site.cvPdf && (
          <a class="btn" href={withBase(site.cvPdf)} download>
            <Icon name="download" size={18} /> CV (PDF)
          </a>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .prose {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 720px;
    font-size: 18px;
    color: var(--ink-2);
  }
  .now {
    margin: 0 0 32px;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 820px;
    color: var(--ink-2);
  }
  .past,
  .projects,
  .teaching {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 16px;
  }
  .past-item,
  .project,
  .teach {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .past-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 12px;
    align-items: baseline;
  }
  h3 {
    font-size: 18px;
    font-weight: 700;
    line-height: 1.3;
  }
  .when,
  .meta {
    font-size: 13px;
    color: var(--muted);
  }
  .role {
    font-style: italic;
    color: var(--ink-2);
    font-size: 15px;
  }
  .past-item p,
  .project p,
  .teach p {
    font-size: 15px;
    color: var(--ink-2);
  }
  .featured {
    display: block;
    padding: 28px;
    margin-bottom: 16px;
    border: 2px solid var(--accent);
    background: var(--accent-soft);
    color: var(--ink);
    text-decoration: none;
  }
  .featured:hover {
    color: var(--ink);
  }
  .featured-copy {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 760px;
  }
  .featured h3 {
    font-size: clamp(22px, 3vw, 28px);
  }
  .featured p {
    color: var(--ink-2);
  }
  .featured-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    color: var(--accent);
  }
  .featured:hover .featured-cta {
    color: var(--accent-hover);
  }
  .tags {
    list-style: none;
    padding: 0;
    margin: 4px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tags li {
    font-size: 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 2px 10px;
    color: var(--muted);
  }
  .classes {
    margin: 4px 0 0;
    padding-left: 20px;
    font-size: 14px;
    color: var(--ink-2);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .subhead {
    margin: 40px 0 16px;
    font-size: 20px;
  }
  .about {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .favorites {
    margin-top: 20px;
    max-width: 900px;
  }
  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .contact .btn {
    max-width: 100%;
    overflow-wrap: anywhere;
  }
</style>
