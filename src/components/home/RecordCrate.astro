---
// Carrusel de vinilos: una funda por artista con su carátula; el disco asoma al pasar el mouse.
import Icon from '../Icon.astro';
import { withBase } from '../../data/site';

interface Artist {
  name: string;
  cover: string;
}

interface Props {
  artists: Artist[];
  label: string;
}

const { artists, label } = Astro.props;
const spotify = (name: string) => `https://open.spotify.com/search/${encodeURIComponent(name)}/artists`;
---

<div class="crate" data-carousel>
  <div class="head">
    <span class="count">{artists.length} artistas</span>
    <div class="controls">
      <button type="button" class="ctrl prev" data-prev aria-label="Ver artistas anteriores">
        <Icon name="arrow" size={20} />
      </button>
      <button type="button" class="ctrl" data-next aria-label="Ver más artistas">
        <Icon name="arrow" size={20} />
      </button>
    </div>
  </div>

  <ol class="track" data-track aria-label={label}>
    {
      artists.map(({ name, cover }, i) => (
        <li class="item">
          <a
            href={spotify(name)}
            target="_blank"
            rel="noopener"
            aria-label={`${name} en Spotify (se abre en otra pestaña)`}
          >
            <span class="record" aria-hidden="true" />
            <span class="sleeve" aria-hidden="true">
              <img src={withBase(cover)} alt="" width="320" height="320" loading="lazy" decoding="async" />
              <span class="rank">{String(i + 1).padStart(2, '0')}</span>
            </span>
            <span class="name">{name}</span>
          </a>
        </li>
      ))
    }
  </ol>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const step = () => Math.max(track.clientWidth * 0.8, 200);
    root.querySelector('[data-prev]')!.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    root.querySelector('[data-next]')!.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
  });
</script>

<style>
  .crate {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
  }
  .count {
    font-size: 15px;
    font-variant: small-caps;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .controls {
    display: flex;
    gap: 8px;
  }
  .ctrl {
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1.5px solid var(--ink);
    border-radius: 50%;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }
  .ctrl:hover {
    background: var(--surface);
  }
  .ctrl.prev :global(svg) {
    transform: rotate(180deg);
  }

  .track {
    list-style: none;
    margin: 0;
    padding: 8px 4px 16px;
    display: flex;
    gap: 22px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding: 4px;
    scrollbar-width: thin;
    scrollbar-color: var(--wood) transparent;
  }
  @media (prefers-reduced-motion: reduce) {
    .track {
      scroll-behavior: auto;
    }
  }
  .item {
    flex: 0 0 auto;
    scroll-snap-align: start;
  }
  .item a {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 188px;
    color: var(--ink);
    text-decoration: none;
  }

  /* disco que asoma por la derecha de la funda */
  .record {
    position: absolute;
    top: 6px;
    left: 18px;
    width: 152px;
    height: 152px;
    border-radius: 50%;
    background:
      radial-gradient(circle, #c9a24a 0 13%, #111 14% 16%, transparent 17%),
      repeating-radial-gradient(circle, #1a1a1a 0 2px, #262626 2px 4px);
    box-shadow: 0 4px 10px -4px rgb(0 0 0 / 0.6);
    transition: transform 0.25s ease;
  }
  .item a:hover .record,
  .item a:focus-visible .record {
    transform: translateX(34px) rotate(40deg);
  }

  .sleeve {
    position: relative;
    width: 164px;
    height: 164px;
    display: block;
    border-radius: 3px;
    overflow: hidden;
    background: var(--wood-back);
    box-shadow:
      inset 0 0 0 1px rgb(0 0 0 / 0.25),
      0 10px 18px -12px rgb(40 20 5 / 0.8);
  }
  .sleeve img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .rank {
    position: absolute;
    top: 8px;
    left: 8px;
    padding: 1px 7px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    color: #2b1d12;
    background: #f6ecd6;
    border-radius: 2px;
  }
  .name {
    width: 164px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 16px;
    line-height: 1.25;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .item a:hover .name {
    color: var(--accent);
  }
</style>
