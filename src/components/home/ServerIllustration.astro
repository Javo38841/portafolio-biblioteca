---
// El homelab real es un notebook. En su pantalla, el flujo de lo que corre dentro.
const rows = ['Docker · dev · prod · MinIO', 'PostgreSQL 16 · dev y prod', 'Runner de GitHub Actions'];
---

<svg viewBox="0 0 360 236" role="img" aria-labelledby="nb-title nb-desc" class="notebook">
  <title id="nb-title">El notebook que hace de servidor</title>
  <desc id="nb-desc">
    Un notebook abierto. En su pantalla, Cloudflare Tunnel conecta con Ubuntu Server, que corre Docker con los stacks
    de dev, prod y MinIO, PostgreSQL 16 y el runner de GitHub Actions.
  </desc>

  <ellipse cx="180" cy="226" rx="168" ry="6" class="shadow"></ellipse>

  <!-- tapa -->
  <rect x="40" y="8" width="280" height="182" rx="10" class="bezel"></rect>
  <rect x="52" y="20" width="256" height="158" rx="3" class="screen"></rect>

  <!-- flujo en pantalla -->
  <rect x="122" y="30" width="116" height="22" rx="11" class="node"></rect>
  <text x="180" y="45" text-anchor="middle" class="node-text">Cloudflare Tunnel</text>
  <line x1="180" y1="53" x2="180" y2="64" class="arrow"></line>
  <path d="M175 60 L180 66 L185 60" class="arrow-head"></path>

  <rect x="68" y="68" width="224" height="102" rx="4" class="host"></rect>
  <text x="78" y="82" class="host-text">Ubuntu Server</text>
  {
    rows.map((r, i) => {
      const y = 88 + i * 26;
      return (
        <g>
          <rect x="78" y={y} width="204" height="20" rx="3" class="row" />
          <circle cx="90" cy={y + 10} r="3.5" class={i === 1 ? 'led data' : 'led ok'} />
          <text x="102" y={y + 14} class="row-text">
            {r}
          </text>
        </g>
      );
    })
  }

  <!-- bisagra y base -->
  <rect x="40" y="188" width="280" height="6" class="hinge"></rect>
  <path d="M8 194 H352 L338 214 Q336 218 330 218 H30 Q24 218 22 214 Z" class="base"></path>
  <rect x="150" y="194" width="60" height="5" rx="2" class="notch"></rect>
</svg>

<style>
  .notebook {
    width: 100%;
    height: auto;
    display: block;
    font-family: var(--font-mono);
  }
  .shadow {
    fill: rgb(0 0 0 / 0.25);
  }
  .bezel {
    fill: #2b2f36;
  }
  .screen {
    fill: var(--terminal);
  }
  .node {
    fill: none;
    stroke: var(--terminal-key);
    stroke-width: 1.5;
  }
  .node-text {
    font-size: 10px;
    fill: var(--on-terminal);
  }
  .arrow,
  .arrow-head {
    stroke: var(--terminal-key);
    stroke-width: 1.5;
    fill: none;
  }
  .host {
    fill: none;
    stroke: #5a6673;
    stroke-dasharray: 4 3;
  }
  .host-text {
    font-size: 9px;
    font-weight: 600;
    fill: var(--terminal-val);
  }
  .row {
    fill: rgb(255 255 255 / 0.07);
  }
  .row-text {
    font-size: 9.5px;
    fill: var(--on-terminal);
  }
  .led.ok {
    fill: #7fc27a;
  }
  .led.data {
    fill: var(--terminal-val);
  }
  .hinge {
    fill: #3a3f47;
  }
  .base {
    fill: #b9bec6;
  }
  .notch {
    fill: #9aa0a8;
  }
</style>
