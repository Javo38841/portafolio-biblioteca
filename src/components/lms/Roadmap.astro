---
import stats from '../../data/stats.json';

const { epics, infra } = stats.roadmap;
---

<div class="roadmap">
  {
    epics.map((e) => (
      <details class="card epic">
        <summary>
          <span class="mono epic-id">{e.id}</span>
          <span class="epic-title">{e.title}</span>
          <span class="meta">
            <span class="count">
              {e.stories.length} {e.stories.length === 1 ? 'historia' : 'historias'}
            </span>
            <span class="status">{e.status}</span>
          </span>
        </summary>
        {e.stories.length > 0 ? (
          <ol class="stories">
            {e.stories.map((s) => (
              <li>
                <span class="mono story-id">{s.id}</span>
                <span class="story-title">{s.title}</span>
                <span class="mono issue">#{s.issue}</span>
              </li>
            ))}
          </ol>
        ) : (
          <p class="empty">Historias por definir.</p>
        )}
      </details>
    ))
  }
</div>

<div class="infra">
  {
    infra.map((t) => (
      <div class="infra-item">
        <span class="mono tag">INFRA</span>
        <span>{t.title}</span>
        <span class="mono issue">#{t.issue}</span>
      </div>
    ))
  }
</div>

<style>
  .roadmap {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: 10px;
    align-items: start;
  }
  .epic {
    padding: 0;
  }
  .epic[open] {
    border-color: var(--accent);
  }
  summary {
    list-style: none;
    cursor: pointer;
    padding: 14px 16px;
    min-height: 44px;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 4px 12px;
    align-items: baseline;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+';
    grid-column: 3;
    grid-row: 1;
    font-family: var(--font-mono);
    color: var(--muted);
  }
  .epic[open] summary::after {
    content: '−';
  }
  /* cada épica es un libro: el resumen es el lomo de color */
  .epic {
    overflow: hidden;
  }
  .epic summary {
    background-color: var(--spine, #2f4f6b);
    background-image: linear-gradient(90deg, rgb(0 0 0 / 0.2), rgb(255 255 255 / 0.06) 40%, rgb(0 0 0 / 0.15));
    color: var(--spine-text);
  }
  .epic:nth-child(6n + 1) {
    --spine: #7a2e2e;
  }
  .epic:nth-child(6n + 2) {
    --spine: #2f4f6b;
  }
  .epic:nth-child(6n + 3) {
    --spine: #3e5f3a;
  }
  .epic:nth-child(6n + 4) {
    --spine: #7a5b14;
  }
  .epic:nth-child(6n + 5) {
    --spine: #5a3a5e;
  }
  .epic:nth-child(6n + 6) {
    --spine: #6b3a1e;
  }
  .epic summary .epic-id,
  .epic summary .meta,
  .epic summary::after {
    color: #f0d68a;
  }
  .epic summary .status {
    border-color: rgb(240 214 138 / 0.6);
  }
  .epic-id {
    font-size: 13px;
    font-weight: 600;
    color: var(--accent);
  }
  .epic-title {
    font-weight: 600;
    font-size: 15px;
  }
  .meta {
    grid-column: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 10px;
    font-size: 12px;
    color: var(--muted);
  }
  .status {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0 8px;
  }
  .stories {
    list-style: none;
    margin: 0;
    padding: 4px 16px 16px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .stories li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 10px;
    align-items: baseline;
    font-size: 14px;
    padding-top: 8px;
  }
  .story-id {
    font-size: 12px;
    color: var(--data);
    font-weight: 600;
  }
  .story-title {
    color: var(--ink-2);
  }
  .issue {
    font-size: 12px;
    color: var(--muted);
  }
  .empty {
    margin: 0;
    padding: 12px 16px 16px;
    border-top: 1px solid var(--line);
    font-size: 14px;
    color: var(--muted);
  }
  .infra {
    margin-top: 16px;
  }
  .infra-item {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 12px;
    align-items: baseline;
    border: 1.5px dashed var(--dashed);
    border-radius: var(--radius);
    padding: 12px 16px;
    font-size: 14px;
    color: var(--ink-2);
  }
  .tag {
    font-size: 12px;
    font-weight: 600;
    color: var(--accent);
  }
</style>
